# Dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing and coverage
/coverage/
playwright-report/
test-results/

# Next.js
/.next/
/out/

# Production build
/build/

# Environment files
.env
.env.*
!.env.example

# Vercel
.vercel/

# TypeScript
*.tsbuildinfo

# Python environments and caches
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.py[cod]
.python-version

# Raw source data remains build-time only
data/raw/*
!data/raw/.gitkeep

# Only validated aggregate artifacts are committed
data/generated/*
!data/generated/.gitkeep
!data/generated/foster_capacity.db
!data/generated/metadata.json
!data/generated/county-summary.csv

# SQLite temporary and sidecar files
*.db-journal
*.db-shm
*.db-wal
*.tmp.db
*.tmp.csv

# Operating system and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Certificates and private keys
*.pem
*.key